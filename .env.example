# GEMINI_API_KEY: Optional. If empty, CyberRakshak uses the deterministic SOC fallback.
GEMINI_API_KEY=

# Session signing secret — change this in production.
SESSION_SECRET=change-me-to-a-long-random-string

# HTTP port for the Node SOC server
PORT=3000

# Supabase (required for production persistence)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional LLM overrides
LLM_API_KEY=
LLM_MODEL=gemini-3.7-flash
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
